TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgres://tourbot:tourbot@localhost:5432/tourbot?sslmode=disable
PORT=8080
# APP_BASE_URL=https://your-tunnel.example
TELEGRAM_WEBAPP_AUTH_MAX_AGE=5m
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Speech-to-text model for Telegram voice notes and audio attachments.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai
LLM_TARIFFS_DIR=tariffs
LLM_MAX_TOKENS=2048
LLM_HISTORY_MAX_MESSAGES=20
TOOL_CALL_MAX_ITERATIONS=10
TOOLS_CURRENT_TIME_ENABLED=true
TOOLS_CURRENT_TIME_DEFAULT_TIMEZONE=Europe/Madrid
TOOLS_MCPS=wikipedia,openstreetmap
TOOLS_WIKIPEDIA_URL=http://127.0.0.1:8088/mcp
TOOLS_WIKIPEDIA_AUTH_TYPE=none
TOOLS_WIKIPEDIA_TIMEOUT=30s
# TOOLS_WIKIPEDIA_ENABLED=false
TOOLS_OPENSTREETMAP_URL=http://127.0.0.1:3010/mcp
TOOLS_OPENSTREETMAP_AUTH_TYPE=none
TOOLS_OPENSTREETMAP_TIMEOUT=30s
# TOOLS_OPENSTREETMAP_ENABLED=false
ACCESS_PIN=1234
LOG_LEVEL=info
