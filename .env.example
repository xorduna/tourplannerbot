TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=-1001234567890
ENV=development
DATABASE_URL=postgres://tourbot:tourbot@localhost:5432/tourbot?sslmode=disable
PORT=8080
# APP_BASE_URL=https://your-tunnel.example
TELEGRAM_WEBAPP_AUTH_MAX_AGE=5m
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Speech-to-text model for Telegram voice notes and audio attachments.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai
LLM_TARIFFS_DIR=tariffs
LLM_MAX_TOKENS=2048
LLM_HISTORY_MAX_MESSAGES=20
TOOL_CALL_MAX_ITERATIONS=10
TOOLS_CURRENT_TIME_ENABLED=true
TOOLS_CURRENT_TIME_DEFAULT_TIMEZONE=Europe/Madrid
# Supplying all three credentials enables the Bigin tools. Deal-note creation
# requires ZohoBigin.modules.pipelines.CREATE and ZohoBigin.modules.notes.CREATE.
TOOLS_BIGIN_REFRESH_TOKEN=
TOOLS_BIGIN_CLIENT_ID=
TOOLS_BIGIN_CLIENT_SECRET=
# TOOLS_BIGIN_ACCOUNTS_URL=https://accounts.zoho.eu
# TOOLS_BIGIN_API_URL=https://www.zohoapis.eu
# TOOLS_BIGIN_TIMEOUT=30s
# Supplying all three credentials enables Gmail draft creation and updates.
# The token must include the https://www.googleapis.com/auth/gmail.compose scope.
TOOLS_GMAIL_REFRESH_TOKEN=
TOOLS_GMAIL_CLIENT_ID=
TOOLS_GMAIL_CLIENT_SECRET=
# TOOLS_GMAIL_OAUTH_URL=https://oauth2.googleapis.com/token
# TOOLS_GMAIL_API_URL=https://gmail.googleapis.com
# TOOLS_GMAIL_TIMEOUT=30s
# Supplying the Brave Search subscription token enables the native web_search tool.
TOOLS_BRAVE_TOKEN=
# TOOLS_BRAVE_API_URL=https://api.search.brave.com
# TOOLS_BRAVE_TIMEOUT=30s
# TOOLS_BRAVE_COUNT=5
TOOLS_MCPS=wikipedia,openstreetmap
TOOLS_WIKIPEDIA_URL=http://127.0.0.1:8088/mcp
TOOLS_WIKIPEDIA_AUTH_TYPE=none
TOOLS_WIKIPEDIA_TIMEOUT=30s
# TOOLS_WIKIPEDIA_ENABLED=false
TOOLS_OPENSTREETMAP_URL=http://127.0.0.1:3010/mcp
TOOLS_OPENSTREETMAP_AUTH_TYPE=none
TOOLS_OPENSTREETMAP_TIMEOUT=30s
# TOOLS_OPENSTREETMAP_ENABLED=false
ACCESS_PIN=1234
LOG_LEVEL=info
